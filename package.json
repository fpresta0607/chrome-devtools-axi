{
  "name": "chrome-devtools-axi",
  "version": "0.1.40-codegoblins.1",
  "packageManager": "pnpm@11.1.1",
  "description": "AXI-compliant chrome-devtools-mcp wrapper — combined operations, TOON output, contextual suggestions",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kunchenguid/chrome-devtools-axi.git"
  },
  "keywords": [
    "chrome",
    "devtools",
    "browser",
    "cli",
    "agent",
    "axi",
    "toon",
    "mcp"
  ],
  "bin": {
    "chrome-devtools-axi": "dist/bin/chrome-devtools-axi.js"
  },
  "files": [
    "dist",
    "skills/chrome-devtools-axi",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && node --input-type=module -e \"import { chmodSync } from 'node:fs'; chmodSync('dist/bin/chrome-devtools-axi.js', 0o755)\"",
    "build:skill": "tsx scripts/build-skill.ts",
    "dev": "tsx bin/chrome-devtools-axi.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@toon-format/toon": "^2.3.1",
    "axi-sdk-js": "^0.1.10"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "chrome-devtools-mcp": "1.11.0",
    "prettier": "^3.8.3",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "yaml": "^2.9.0"
  }
}
